# ---------------------------------------------------------------------------
# AutoRefund Core API configuration (copy to .env and edit)
# .env is ignored by git - never commit real passwords.
# Hardware and kiosk identity settings live in kiosk_agent\.env since Phase 2.
# ---------------------------------------------------------------------------

# PostgreSQL connection (Windows: installed with the EDB PostgreSQL installer)
DATABASE_URL=postgresql://refund_user:CHANGE_ME@localhost:5432/refund_kiosk

# Web server. Must stay 127.0.0.1 while DEVICE_AUTH_MODE=development.
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
# Never enable on a kiosk: the debugger allows remote code execution.
FLASK_DEBUG=false
# Allowed browser origins for the EMPLOYEE screens (comma separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Kiosk agent authentication. "development" = local development keys only
# (python manage_tenancy.py issue-dev-key ...). The Core API refuses to start
# in this mode unless FLASK_HOST is 127.0.0.1, localhost or ::1.
DEVICE_AUTH_MODE=development
DEV_KEY_MAX_DAYS=30
# Largest item photo the kiosk agent may upload (bytes)
MAX_EVIDENCE_BYTES=5242880

# Return rules (one policy for all retailers for now)
RETURN_WINDOW_DAYS=30
# Times a customer may try again after a rejected return (0 = never)
RETURN_RETRY_LIMIT_AFTER_REJECTION=1
# true = a return with no photo always goes to employee review
REQUIRE_PHOTO_FOR_AUTO_APPROVAL=true

# Employee login session length (hours)
STAFF_SESSION_HOURS=8

# Evidence photos and logs (relative paths are relative to self_refund_backend\)
CAPTURE_DIR=captures
LOG_DIR=logs
