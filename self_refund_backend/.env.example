# ---------------------------------------------------------------------------
# AutoRefund backend configuration (copy to .env and edit)
# .env is ignored by git - never commit real passwords.
# ---------------------------------------------------------------------------

# PostgreSQL connection (Windows: installed with the EDB PostgreSQL installer)
DATABASE_URL=postgresql://refund_user:CHANGE_ME@localhost:5432/refund_kiosk

# Web server. Keep 127.0.0.1 when the kiosk browser runs on the same PC.
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
# Never enable on a kiosk: the debugger allows remote code execution.
FLASK_DEBUG=false
# Allowed frontend origins (comma separated) or *
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

KIOSK_ID=KIOSK-001

# Storage (relative paths are relative to self_refund_backend\)
CAPTURE_DIR=captures
LOG_DIR=logs

# ---------------------------------------------------------------------------
# Hardware
#   real = physical USB devices
#   mock = SIMULATED devices for development only (never for real refunds)
# ---------------------------------------------------------------------------
HARDWARE_MODE=real
# Override per device if only one device is attached, e.g. SCALE_MODE=mock
# CAMERA_MODE=real
# SCALE_MODE=real

# Camera: Windows index (0 = first camera). Empty = try 0..3 automatically.
CAMERA_INDEX=
# auto (Windows: DirectShow then Media Foundation) | dshow | msmf | any
CAMERA_BACKEND=auto
CAMERA_WIDTH=640
CAMERA_HEIGHT=480

# USB HID scale (defaults: DYMO M10). Use "python test_scale.py --list".
SCALE_VENDOR_ID=0x0922
SCALE_PRODUCT_ID=0x8003
SCALE_READ_TIMEOUT_MS=2000

# Only used when SCALE_MODE=mock
MOCK_SCALE_GRAMS=250
