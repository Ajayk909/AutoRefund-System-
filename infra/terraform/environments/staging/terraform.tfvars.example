# Copy to terraform.tfvars (git-ignored) if you ever need `terraform plan`
# to use real values instead of the placeholder defaults. This environment
# is never applied in Phase 3.

allowed_ingress_cidrs = ["203.0.113.5/32"]
alarm_email           = "you@example.com"

# GitHub's numeric IDs: gh api repos/<owner>/<repo> --jq ".owner.id, .id"
github_repo_owner_id = "000000000"
github_repo_id       = "0000000000"
