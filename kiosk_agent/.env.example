# ---------------------------------------------------------------------------
# AutoRefund kiosk agent (copy to .env). .env is ignored by git.
# ---------------------------------------------------------------------------

# Local HTTP for the kiosk UI. Must stay on 127.0.0.1.
AGENT_HOST=127.0.0.1
AGENT_PORT=5100
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Core API
CORE_API_URL=http://127.0.0.1:5000
CORE_API_TIMEOUT_SECONDS=10

# Kiosk identity - DEVELOPMENT ONLY. Fill both with:
#   cd ..\self_refund_backend
#   .venv\Scripts\python manage_tenancy.py issue-dev-key KIOSK-001 --write-env ..\kiosk_agent\.env
KIOSK_ID=KIOSK-001
KIOSK_DEV_KEY=

# Local storage (relative paths are relative to kiosk_agent\)
AGENT_DB_PATH=data\kiosk_agent.sqlite3
CAPTURE_DIR=captures
LOG_DIR=logs
CAPTURE_MAX_AGE_SECONDS=900
SESSION_TIMEOUT_SECONDS=900

# ---------------------------------------------------------------------------
# Hardware
#   real = physical USB devices
#   mock = SIMULATED devices for development only (never for real refunds)
# ---------------------------------------------------------------------------
HARDWARE_MODE=real
# CAMERA_MODE=real
# SCALE_MODE=real
CAMERA_INDEX=
CAMERA_BACKEND=auto
CAMERA_WIDTH=640
CAMERA_HEIGHT=480
SCALE_VENDOR_ID=0x0922
SCALE_PRODUCT_ID=0x8003
SCALE_READ_TIMEOUT_MS=2000
MOCK_SCALE_GRAMS=250
